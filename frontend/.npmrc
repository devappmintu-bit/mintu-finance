# ─── Round 54b: CI/CD hardening ─────────────────────────────────────
# Pre-emptive npm config so the EAS deployer pipeline stops creating its
# own throwaway .npmrc on every build ("Creating .npmrc for peer
# dependency handling..." log line). Also kills two slow CI calls
# (audit + funding lookup) that add ~30s to every install for zero
# value during a build.
#
# Each line below is intentional — don't remove without checking the
# corresponding effect in the EAS build log.

# Tolerate React 19 / RN 0.81 era peer-dep noise. Required for
# expo-router 6 + reanimated 4 + several Sentry transitives that
# haven't bumped their `peerDependencies` ranges yet.
legacy-peer-deps=true

# yarn 1 / npm 10 emit slow audit / funding HTTP calls during
# `npm install` — adds 20-40s on the EAS builder. We don't act on
# those signals during a build anyway (security review happens out-
# of-band). Disable for build-time speed.
fund=false
audit=false

# Speeds up cold installs in CI by skipping deprecated-package
# warnings that we already see (rimraf 3, glob 7, uuid 7 — all
# transitive, all logged ad nauseam in build output).
loglevel=warn
