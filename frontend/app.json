{
  "expo": {
    "name": "MintU",
    "jsEngine": "hermes",
    "slug": "mintu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mintu",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mintu.finance",
      "associatedDomains": [
        "applinks:mintu.app",
        "applinks:www.mintu.app"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice to add expenses hands-free",
        "NSContactsUsageDescription": "Pick friends to split group expenses",
        "NSCameraUsageDescription": "Take a profile photo for your MintU account",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo from your library",
        "NSFaceIDUsageDescription": "MintU uses Face ID to protect your financial data"
      }
    },
    "android": {
      "package": "com.mintu.finance",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B12"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mintu.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.mintu.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "mintu",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "MintU — Money, simplified",
      "shortName": "MintU",
      "themeColor": "#FF6B1A",
      "backgroundColor": "#0B0B12"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B12"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
